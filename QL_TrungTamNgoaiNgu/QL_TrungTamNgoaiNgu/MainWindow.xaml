<Window x:Class="QL_TrungTamNgoaiNgu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quan ly Trung tam Ngoai ngu"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1080"
        Background="#101114"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191B20" Opacity="0.96" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A2A16" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF7ED" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#F7C98B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A00" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A1C10" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#201A14" />
            <Setter Property="BorderBrush" Value="#5B3A18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A1C10" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF8A00" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A260F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#201A14" />
            <Setter Property="BorderBrush" Value="#4B351C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A1C10" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF8A00" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111318" />
            <Setter Property="BorderBrush" Value="#4B351C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <!-- STYLE CHO SCROLLBAR HẸP VÀ MÀU XANH ĐEN NHẠT (CẢ DỌC VÀ NGANG) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Màu xanh đen nhạt #2D323C -->
                                                <Border Background="#2D323C" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background" Value="#3E4552" />
                            </Trigger>
                            <!-- Xử lý kích thước cho thanh dọc -->
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="6"/>
                                <Setter Property="MinWidth" Value="6"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="1,0"/>
                            </Trigger>
                            <!-- Xử lý kích thước cho thanh ngang -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="6"/>
                                <Setter Property="MinHeight" Value="6"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE CHO SCROLLVIEWER ĐỂ ÁP DỤNG SCROLLBAR -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" 
                                                    CanHorizontallyScroll="False" 
                                                    CanVerticallyScroll="False" 
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                    Content="{TemplateBinding Content}" 
                                                    Grid.Column="0" 
                                                    Margin="{TemplateBinding Padding}" 
                                                    Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Arrow" 
                                       Grid.Column="1" 
                                       Maximum="{TemplateBinding ScrollableHeight}" 
                                       Minimum="0" 
                                       Grid.Row="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" 
                                       AutomationProperties.AutomationId="HorizontalScrollBar" 
                                       Cursor="Arrow" 
                                       Grid.Column="0" 
                                       Maximum="{TemplateBinding ScrollableWidth}" 
                                       Minimum="0" 
                                       Orientation="Horizontal" 
                                       Grid.Row="1" 
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" 
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportWidth}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111318" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#332716" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#3A2A14" />
            <Setter Property="VerticalGridLinesBrush" Value="#3A2A14" />

            <Setter Property="RowBackground" Value="#15171C" />
            <Setter Property="AlternatingRowBackground" Value="#1D1812" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AutoGenerateColumns" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A1C10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#5B3A18" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />

            <Style.Triggers>
                <!-- Hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A1C10"/>
                </Trigger>

                <!-- Selected -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF8A00"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="230" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource PanelBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="18,18,6,18" 
        Margin="0,0,16,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== HEADER ===== -->
                <StackPanel Grid.Row="0" Margin="0,0,12,18">
                    <TextBlock Text="QL HOC VIEN"
                       FontSize="22"
                       FontWeight="Bold" />
                    <TextBlock Text="Trung tam ngoai ngu"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,4,0,0" />
                </StackPanel>

                <!-- ===== SCROLL LIST ===== -->
                <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
                    <!-- Tạo khoảng trống giữa list và thanh cuộn -->

                    <ScrollViewer.Resources>
                        <!-- Style làm gọn thanh cuộn cho Dark Theme -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <!-- Màu thanh cuộn tối, hòa nhập với nền -->
                                                                <Border Background="#3E3E42" 
                                                                CornerRadius="3" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                    <ItemsControl ItemsSource="{Binding Tables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarButtonStyle}"
                                Margin="0,0,0,8"
                                Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                            <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,3,8,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#5B3A18"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,4"
                                        VerticalAlignment="Top">
                                            <TextBlock Text="{Binding RowCount}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <!-- ===== MAIN PANEL ===== -->
        <Border Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Thanh tieu de + user info + Tai lai / Xuat CSV / Dang xuat -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: CRUD + Tim kiem + Trang thai gop chung -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2: Noi dung chinh -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== ROW 0: Header toolbar ===== -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ToastMessage}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- User badge -->
                        <Border Background="#2A1C10"
                                BorderBrush="#FF8A00"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserSummary}"
                                       Foreground="#FFBF00"
                                       FontWeight="SemiBold" />
                        </Border>

                        <!-- Tai lai -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Tai lai" />

                        <!-- Xuat CSV -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding ExportCsvCommand}"
                                Content="Xuat CSV" />

                        <!-- Dang xuat — ngoai cung ben phai -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="LogoutButton_OnClick"
                                Background="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="#FFFFFF"
                                Margin="0"
                                Content="Dang xuat" />
                    </StackPanel>
                </DockPanel>

                <!-- ===== ROW 1: CRUD + Tim kiem + Trang thai ===== -->
                <Border Grid.Row="1"
                        Background="#15171C"
                        BorderBrush="#3A2A16"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <!-- Nhom nut CRUD ben trai -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding CanCreate}"
                                    Click="CreateButton_OnClick"
                                    Background="{StaticResource SuccessBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}"
                                    Foreground="#FFFFFF"
                                    Content="Them" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="EditButton_OnClick"
                                    Background="{StaticResource WarningBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    Foreground="#FFFFFF"
                                    Content="Sua" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding CanDelete}"
                                    Click="DeleteButton_OnClick"
                                    Background="{StaticResource DangerBrush}"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    Foreground="#FFFFFF"
                                    Content="Xoa" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding CanUsePayment}"
                                    Visibility="{Binding PaymentButtonVisibility}"
                                    Click="PaymentButton_OnClick"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="#FFFFFF"
                                    Content="Thanh toan" />
                        </StackPanel>

                        <!-- Trang thai Dang tai ben phai -->
                        <Border DockPanel.Dock="Right"
                                Background="#2A1C10"
                                BorderBrush="#5B3A18"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,0" 
                                MinWidth="140" 
                                Height="38"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SearchVisibility}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Dang tai: "
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IsBusy}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>


                        <!-- O tim kiem chiem phan con lai -->
                        <TextBox DockPanel.Dock="Right"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Margin="12,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="{Binding SearchVisibility}"
                                 ToolTip="Tim kiem tren tat ca cot cua bang hien tai" />
                    </DockPanel>
                </Border>

                <!-- ===== ROW 3: Content area ===== -->
                <DataGrid x:Name="MainDataGrid"
                          Grid.Row="2"
                          Visibility="{Binding DataGridVisibility}"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}"
                          SelectionMode="Extended"
                          AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn"
                          MouseDoubleClick="MainDataGrid_OnMouseDoubleClick" />

                <ScrollViewer Grid.Row="2"
                              Visibility="{Binding AccountingDashboardVisibility}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#2A1C10" BorderBrush="#5B3A18" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Tong hoc phi da thu" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TotalRevenueText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#2A1515" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Hoa don chua hoan tat" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding UnpaidInvoiceCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#102217" BorderBrush="#166534" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Hoc vien dang hoat dong" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ActiveStudentCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#15171C" BorderBrush="#3A2A16" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Dong tien hoc phi theo thang" FontSize="18" FontWeight="Bold" Foreground="#FFBF00" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding MonthlyRevenueChart}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                                    <Border Grid.Column="1" Height="18" Background="#2A1C10" CornerRadius="8" VerticalAlignment="Center">
                                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="8" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFBF00" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#15171C" BorderBrush="#3A2A16" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hoc vien theo tung khoa" FontSize="18" FontWeight="Bold" Foreground="#FFBF00" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding CourseStudentChart}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="54" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                                    <Border Grid.Column="1" Height="18" Background="#102217" CornerRadius="8" VerticalAlignment="Center">
                                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{StaticResource SuccessBrush}" CornerRadius="8" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFBF00" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2"
                              Visibility="{Binding StudentDashboardVisibility}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#2A1C10" BorderBrush="#5B3A18" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Lich hoc hom nay" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StudentTodaySchedule.Count}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#102217" BorderBrush="#166534" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Khoa hoc dang theo" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StudentCourses.Count}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#15171C" BorderBrush="#3A2A16" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Dau diem da co" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StudentGrades.Count}" FontSize="28" FontWeight="Bold" Foreground="#FFBF00" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Lich hoc va phong hoc trong ngay" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding StudentTodaySchedule}" MaxHeight="180" Margin="0,0,0,18" AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Khoa hoc cua toi" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding StudentCourses}" MaxHeight="260" AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Bang diem" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding StudentGrades}" MaxHeight="260" AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
