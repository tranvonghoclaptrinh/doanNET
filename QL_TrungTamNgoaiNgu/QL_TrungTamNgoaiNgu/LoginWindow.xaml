<Window x:Class="QL_TrungTamNgoaiNgu.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dang nhap"
        Height="580"
        Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#101114"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFBF00" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#F7C98B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A00" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111318" />
            <Setter Property="BorderBrush" Value="#4B351C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111318" />
            <Setter Property="BorderBrush" Value="#4B351C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111318" />
            <Setter Property="BorderBrush" Value="#4B351C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9933" />
                    <Setter Property="BorderBrush" Value="#FF9933" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600" />
                    <Setter Property="BorderBrush" Value="#CC6600" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#191B20" BorderBrush="#3A2A16" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,0,18,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ HỌC VIÊN TRUNG TÂM NGOẠI NGỮ" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" LineHeight="36" />
                <TextBlock Text="Đăng nhập bằng email và mật khẩu. Tài khoản sẽ hiển thị cảnh báo nếu nhập sai mật khẩu quá 3 lần."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,18,0,0" TextAlignment="Center" />
                <Border Background="#2A1C10" BorderBrush="#5B3A18" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,28,0,0">
                    <TextBlock Text="Quên mật khẩu: nhập đúng email và số điện thoại để đặt lại mật khẩu mới." Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#191B20" BorderBrush="#3A2A16" BorderThickness="1" CornerRadius="8" Padding="28">
            <TabControl Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                <TabItem Header="Đăng nhập">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Vai trò" Margin="0,0,0,6" />
                        <ComboBox x:Name="RoleComboBox" Margin="0,0,0,14" SelectedIndex="0">
                            <ComboBoxItem Content="Quản trị viên" Tag="Admin" />
                            <ComboBoxItem Content="Kế toán" Tag="Accountant" />
                            <ComboBoxItem Content="Học viên" Tag="Student" />
                            <ComboBoxItem Content="Giảng viên" Tag="Teacher" />
                        </ComboBox>
                        <TextBlock Text="Email" Margin="0,0,0,6" />
                        <TextBox x:Name="EmailTextBox" Margin="0,0,0,14" />
                        <TextBlock Text="Mật khẩu" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="ĐĂNG NHẬP" Click="LoginButton_OnClick" />
                        <TextBlock x:Name="LoginMessageTextBlock" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Quên mật khẩu">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Email" Margin="0,0,0,6" />
                        <TextBox x:Name="ResetEmailTextBox" Margin="0,0,0,14" />
                        <TextBlock Text="Số điện thoại" Margin="0,0,0,6" />
                        <TextBox x:Name="ResetPhoneTextBox" Margin="0,0,0,14" />
                        <TextBlock Text="Mật khẩu mới" Margin="0,0,0,6" />
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,20" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="ĐẶT LẠI MẬT KHẨU" Click="ResetPasswordButton_OnClick" />
                        <TextBlock x:Name="ResetMessageTextBlock" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
