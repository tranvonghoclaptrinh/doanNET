<Window x:Class="QL_TrungTamNgoaiNgu.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toan hoc phi"
        Height="470"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#101114">
    <StackPanel Margin="22">
        <TextBlock Text="Ghi nhan thanh toan" Foreground="#FFBF00" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
        <Border x:Name="PaymentInfoBorder"
                Visibility="Collapsed"
                Background="#1B1712"
                BorderBrush="#5B3A18"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,14">
            <TextBlock x:Name="PaymentInfoTextBlock"
                       Foreground="#F7C98B"
                       TextWrapping="Wrap"
                       LineHeight="22" />
        </Border>
        <TextBlock Text="Ma hoa don" Foreground="#FFBF00" />
        <TextBox x:Name="MaHoaDonTextBox" Height="36" Margin="0,4,0,10" Foreground="#FFBF00" Background="#111318" BorderBrush="#4B351C" />
        <TextBlock Text="So tien" Foreground="#FFBF00" />
        <TextBox x:Name="SoTienTextBox" Height="36" Margin="0,4,0,10" Foreground="#FFBF00" Background="#111318" BorderBrush="#4B351C" />
        <TextBlock Text="Phuong thuc" Foreground="#FFBF00" />
        <ComboBox x:Name="PhuongThucComboBox"
          SelectedIndex="0"
          Height="40"
          Margin="0,4,0,10"
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="#111111"
          Background="#D6A23D"
          BorderBrush="#7A551D"
          Padding="8,4">

            <ComboBox.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#111111"/>
                    <Setter Property="Background" Value="#E5B654"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,6"/>

                    <Style.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#F2C14E"/>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#C98B1F"/>
                            <Setter Property="Foreground" Value="#111111"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Resources>

            <ComboBoxItem Content="Bank transfer"/>
            <ComboBoxItem Content="Cash"/>
            <ComboBoxItem Content="Card"/>
            <ComboBoxItem Content="E-wallet"/>
        </ComboBox>
        <TextBlock Text="Ghi chu" Foreground="#FFBF00" />
        <TextBox x:Name="GhiChuTextBox" Height="36" Margin="0,4,0,16" Foreground="#FFBF00" Background="#111318" BorderBrush="#4B351C" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Huy" Width="90" Height="36" Margin="0,0,8,0" Background="#4B351C" Foreground="#FFFFFF" Click="CancelButton_OnClick" />
            <Button Content="Thanh toan" Width="120" Height="36" Background="#FF8A00" Foreground="#FFFFFF" Click="PayButton_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
